# WorldGraph settings
# ---------------------------------------------------------------------------
# 1. Copy this file and name the copy ".env" (in this same folder):
#        Copy-Item .env.example .env
# 2. Fill in the values below.
# ".env" is listed in .gitignore, so your secrets never reach GitHub.
# ---------------------------------------------------------------------------

# --- Database (needed from Phase 0) -----------------------------------------
# Where to get it: supabase.com -> project "worldgraph" -> "Connect" button
# -> "Session pooler" -> copy the URI. Replace [YOUR-PASSWORD] with your
# database password (forgot it? Project Settings -> Database -> Reset password).
# Use the Session pooler, not "Direct connection": it works on home networks
# without IPv6.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# --- App ---------------------------------------------------------------------
# "development" on your PC; "production" once deployed (Phase 5).
WG_ENV=development

# Pretend the viewer is in this country (two-letter code, e.g. IN, US, DE).
# Only used in development, to test how forecast sources are gated by country.
# Leave empty to treat the viewer's country as unknown (the safest setting).
WG_DEV_VIEWER_COUNTRY=

# --- Later phases (leave commented out for now) ------------------------------
# Phase 2: Claude API key, from console.anthropic.com -> API keys.
# ANTHROPIC_API_KEY=
# Phase 2: the most the pipeline may spend on the Claude API per day, in US$.
# LLM_DAILY_CAP_USD=2
# Phase 2: model names (kept here so they can change without code changes).
# LLM_MODEL_FAST=claude-haiku-4-5
# LLM_MODEL_STRONG=claude-sonnet-5-5
# Phase 2: forecast providers. Real-money providers stay off by default.
# PROVIDER_MANIFOLD_ENABLED=true
# PROVIDER_POLYMARKET_ENABLED=false
