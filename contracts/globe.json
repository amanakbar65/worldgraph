{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "window": {
      "type": "string",
      "enum": [
        "24h",
        "7d",
        "30d"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "impact": {
            "type": "string",
            "enum": [
              "risk",
              "opportunity",
              "neutral"
            ]
          },
          "importance": {
            "type": "number"
          },
          "magnitude": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "sectors": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "energy",
                "agri-food",
                "manufacturing",
                "logistics-trade",
                "finance",
                "tech",
                "health",
                "real-estate",
                "consumer"
              ]
            }
          },
          "first_seen": {
            "type": "string"
          },
          "headline": {
            "type": "string"
          },
          "country_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "lon",
          "lat",
          "impact",
          "importance",
          "magnitude",
          "sectors",
          "first_seen",
          "headline",
          "country_id"
        ],
        "additionalProperties": false
      }
    },
    "hexes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "h3": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "risk": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "opportunity": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "neutral": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "importance": {
            "type": "number"
          }
        },
        "required": [
          "h3",
          "count",
          "risk",
          "opportunity",
          "neutral",
          "importance"
        ],
        "additionalProperties": false
      }
    },
    "arcs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "src_story": {
            "type": "string",
            "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
          },
          "dst_story": {
            "type": "string",
            "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
          },
          "src": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "dst": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "src_country": {
            "type": "string",
            "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
          },
          "dst_country": {
            "type": "string",
            "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
          },
          "link_type": {
            "type": "string",
            "enum": [
              "reported",
              "inferred",
              "projected",
              "conditional"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "impact": {
            "type": "string",
            "enum": [
              "risk",
              "opportunity",
              "neutral"
            ]
          }
        },
        "required": [
          "id",
          "src_story",
          "dst_story",
          "src",
          "dst",
          "src_country",
          "dst_country",
          "link_type",
          "confidence",
          "impact"
        ],
        "additionalProperties": false
      }
    },
    "forecasts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
          },
          "short_title": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "economy",
              "finance",
              "policy",
              "politics",
              "geopolitics",
              "trade",
              "tech",
              "commodities",
              "energy"
            ]
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "change_24h": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "volume": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "volume_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "liquidity": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "thin": {
            "type": "boolean"
          },
          "end_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "type": "string"
          },
          "provider_name": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "region": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "subtype": {
                    "type": "string"
                  },
                  "country_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "name",
                  "subtype",
                  "country_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "lon": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "null"
              }
            ]
          },
          "lat": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              {
                "type": "null"
              }
            ]
          },
          "sparkline": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "is_sample": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "short_title",
          "question",
          "category",
          "probability",
          "change_24h",
          "volume",
          "volume_unit",
          "liquidity",
          "thin",
          "end_date",
          "updated_at",
          "provider",
          "provider_name",
          "url",
          "region",
          "lon",
          "lat",
          "sparkline",
          "is_sample"
        ],
        "additionalProperties": false
      }
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
          },
          "count": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "risk": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "opportunity": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "neutral": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "score": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "count",
          "risk",
          "opportunity",
          "neutral",
          "score"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "window",
    "events",
    "hexes",
    "arcs",
    "forecasts",
    "countries"
  ],
  "additionalProperties": false
}
