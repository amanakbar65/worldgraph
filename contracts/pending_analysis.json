{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
          },
          "titles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "snippets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "first_seen": {
            "type": "string"
          },
          "region": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "subtype": {
                    "type": "string"
                  },
                  "country_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "name",
                  "subtype",
                  "country_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "event_type": {
            "type": "string"
          },
          "sectors": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "energy",
                "agri-food",
                "manufacturing",
                "logistics-trade",
                "finance",
                "tech",
                "health",
                "real-estate",
                "consumer"
              ]
            }
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "region",
                    "organization",
                    "person",
                    "commodity",
                    "sector",
                    "infrastructure",
                    "policy",
                    "indicator",
                    "story",
                    "forecast",
                    "user_entity"
                  ]
                },
                "subtype": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "type",
                "subtype",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "event",
                    "projected"
                  ]
                },
                "headline": {
                  "type": "string"
                },
                "so_what": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "event_type": {
                  "type": "string"
                },
                "impact": {
                  "type": "string",
                  "enum": [
                    "risk",
                    "opportunity",
                    "neutral"
                  ]
                },
                "direction": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "up",
                        "down"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "magnitude": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "horizon": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "now",
                        "weeks",
                        "months"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "confidence": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "importance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "sectors": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "energy",
                      "agri-food",
                      "manufacturing",
                      "logistics-trade",
                      "finance",
                      "tech",
                      "health",
                      "real-estate",
                      "consumer"
                    ]
                  }
                },
                "first_seen": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "region": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
                        },
                        "name": {
                          "type": "string"
                        },
                        "subtype": {
                          "type": "string"
                        },
                        "country_id": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "subtype",
                        "country_id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lon": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lat": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "analysed": {
                  "type": "boolean"
                },
                "is_sample": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "kind",
                "headline",
                "so_what",
                "event_type",
                "impact",
                "direction",
                "magnitude",
                "horizon",
                "confidence",
                "importance",
                "sectors",
                "first_seen",
                "region",
                "lon",
                "lat",
                "source_count",
                "analysed",
                "is_sample"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "titles",
          "snippets",
          "sources",
          "first_seen",
          "region",
          "event_type",
          "sectors",
          "entities",
          "candidates"
        ],
        "additionalProperties": false
      }
    },
    "total_pending": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "items",
    "total_pending"
  ],
  "additionalProperties": false
}
