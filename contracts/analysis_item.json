{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
    },
    "headline": {
      "type": "string"
    },
    "so_what": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "impact": {
      "type": "string",
      "enum": [
        "risk",
        "opportunity",
        "neutral"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "up",
        "down"
      ]
    },
    "magnitude": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "horizon": {
      "type": "string",
      "enum": [
        "now",
        "weeks",
        "months"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sectors": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "energy",
          "agri-food",
          "manufacturing",
          "logistics-trade",
          "finance",
          "tech",
          "health",
          "real-estate",
          "consumer"
        ]
      }
    },
    "actions": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entities": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
      }
    },
    "links": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"
          },
          "link_type": {
            "type": "string",
            "enum": [
              "reported",
              "inferred"
            ]
          },
          "mechanism": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "from",
          "link_type",
          "mechanism",
          "direction",
          "confidence",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "headline",
    "so_what",
    "event_type",
    "impact",
    "direction",
    "magnitude",
    "horizon",
    "confidence",
    "sectors",
    "actions",
    "entities",
    "links"
  ],
  "additionalProperties": false
}
